# Production / Vercel: set this from GitHub/Vercel secrets to use PostgreSQL.
# Vercel Postgres commonly exposes POSTGRES_URL; DATABASE_URL is also supported.
POSTGRES_URL=
# Equivalent PostgreSQL connection-string alias used when POSTGRES_URL is unset.
# Remove the POSTGRES_URL entry above when configuring this alias.
DATABASE_URL=

# Local development: leave POSTGRES_URL empty and Next.js will use a file-backed
# SQLite database that is created automatically from resources/sample-data/logbook.ts.
LOCAL_DATABASE_PATH=.data/ultilog.sqlite

# Logbook scanner: required only when using the scanner endpoint with the
# built-in OpenAI cloud recognition provider. Tests should mock the provider
# instead of calling the real cloud LLM.
OPENAI_API_KEY=
LOGBOOK_SCANNER_MODEL=gpt-4.1-mini

# Production auth: set a stable secret for NextAuth in hosted deployments.
AUTH_SECRET=

# Required for encrypting crew PII at rest. Use a stable, randomly generated
# 32-byte value encoded as 64 hexadecimal characters, base64, or base64url.
# CREW_ENCRYPTION_MASTER_KEY is preferred; the other names are compatibility
# aliases for existing deployments and encrypted data.
CREW_ENCRYPTION_MASTER_KEY=
# CREW_DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY=
# ULTILOG_MASTER_KEY=

# Isolated demo identities expire after six hours by default. Override the
# lifetime here; the included Vercel Cron removes expired records daily.
DEMO_SANDBOX_TTL_HOURS=6
# Protects the cleanup endpoint outside Vercel. Vercel Cron automatically uses
# CRON_SECRET as a Bearer token when that platform variable is configured.
CRON_SECRET=
DEMO_CLEANUP_SECRET=

# Password reset email: configure SMTP in deployed environments so reset
# requests can send real emails. In local development without SMTP_HOST and
# SMTP_FROM, reset links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional override for reset-link generation. On Vercel, the app automatically
# falls back to VERCEL_BRANCH_URL when NEXT_PUBLIC_APP_URL is not set. AUTH_URL
# and NEXTAUTH_URL are also supported as compatibility fallbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# AUTH_URL=
# NEXTAUTH_URL=
# VERCEL_BRANCH_URL is supplied automatically by Vercel.

# Focused mutation request limits (UTF-8 bytes). These are enforced before JSON
# parsing for both declared Content-Length and the actual body.
LOGBOOK_BOAT_REQUEST_BYTES=65536
LOGBOOK_CREW_REQUEST_BYTES=32768
LOGBOOK_SHEET_REQUEST_BYTES=131072
LOGBOOK_LINE_REQUEST_BYTES=32768
LOGBOOK_LINE_REORDER_REQUEST_BYTES=262144
# Full replacement is retained only for explicit legacy import compatibility.
LOGBOOK_IMPORT_REQUEST_BYTES=8388608
# Deprecated fallback used only when LOGBOOK_IMPORT_REQUEST_BYTES is unset.
# LOGBOOK_MAX_REQUEST_BYTES=8388608
# JSON/base64 transport headroom for the default 1 MiB decoded image maximum.
STORED_IMAGE_REQUEST_BYTES=1402200

# Optional integration-test configuration. TEST_POSTGRES_URL must identify a
# dedicated database whose role may create and drop schemas. Live scanner tests
# make real OpenAI API requests and incur usage, so they are disabled by default.
TEST_POSTGRES_URL=
RUN_LIVE_SCANNER_TESTS=false

# NODE_ENV and CI are set by Next.js and CI runners. VERCEL and
# VERCEL_BRANCH_URL are set automatically by Vercel and normally need no manual
# configuration.

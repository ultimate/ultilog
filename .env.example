# Production / Vercel: set this from GitHub/Vercel secrets to use PostgreSQL.
# Vercel Postgres commonly exposes POSTGRES_URL; DATABASE_URL is also supported.
POSTGRES_URL=

# Local development: leave POSTGRES_URL empty and Next.js will use a file-backed
# SQLite database that is created automatically from resources/sample-data/logbook.ts.
LOCAL_DATABASE_PATH=.data/ultilog.sqlite

# Logbook scanner: required only when using the scanner endpoint with the
# built-in OpenAI cloud recognition provider. Tests should mock the provider
# instead of calling the real cloud LLM.
OPENAI_API_KEY=
LOGBOOK_SCANNER_MODEL=gpt-4.1-mini

# Production auth: set a stable secret for NextAuth in hosted deployments.
AUTH_SECRET=
